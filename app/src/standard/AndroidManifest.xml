<?xml version="1.0" encoding="utf-8"?>
<!--
  Standard ships no camera, microphone or Bluetooth feature, so it must not ask for the permissions.

  The main manifest is shared by all four flavors. Every feature that needs these permissions (the
  notebook's audio, photo and video notes, the QR scanner, the Bluetooth board) is reached only from
  SettingsMorePage, which renders behind FlavorConfig.hasMoreTab() and is therefore COMPLETE only.
  Without the removals below, this build's store listing asks for the microphone and the camera to
  run a chess clock that can never open either.

  ACCESS_NETWORK_STATE is declared nowhere in this project: it arrives transitively through
  androidx.camera:camera-video, which depends on androidx.media3:media3-common. The app makes no
  network call at all, so it is removed here too.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.BLUETOOTH" tools:node="remove" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" tools:node="remove" />
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN" tools:node="remove" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" tools:node="remove" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" tools:node="remove" />
    <uses-permission android:name="android.permission.CAMERA" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" tools:node="remove" />

    <uses-feature android:name="android.hardware.camera" tools:node="remove" />

</manifest>
