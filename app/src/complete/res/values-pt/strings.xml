    <!-- Mode guide: names stay English, descriptions are translated -->
    <string name="guide_intro">Documentação exaustiva dos motores de tempo do MasterClock e dos seus submodos, pela ordem da interface.</string>
    <string name="guide_bonus_bronstein_desc">Devolve o tempo gasto no lance, sem nunca exceder o atraso configurado. Não é cumulativo.</string>
    <string name="guide_bonus_fischer_desc">Acrescenta um tempo fixo (incremento) DEPOIS de cada lance.</string>
    <string name="guide_bonus_us_delay_desc">Um atraso antes da contagem. O relógio espera a duração do atraso antes de começar a correr.</string>
    <string name="guide_byoyomi_canadian_desc">Os jogadores têm de completar um número determinado de lances dentro de um único período mais longo.</string>
    <string name="guide_byoyomi_japanese_desc">Depois do tempo principal, os jogadores dispõem de uma série de períodos curtos, reiniciados a cada lance.</string>
    <string name="guide_byoyomi_progressive_desc">O número de lances exigidos aumenta a cada período concluído.</string>
    <string name="guide_chrono_countdown_desc">Relógio principal em contagem decrescente durante toda a partida.</string>
    <string name="guide_chrono_countup_desc">Modo cronómetro que mede o tempo total decorrido.</string>
    <string name="guide_chrono_one_for_all_desc">Relógio global que não muda de jogador quando se premem os botões.</string>
    <string name="guide_counts_down_desc">Parte de um limite e desce até zero lances restantes.</string>
    <string name="guide_counts_up_desc">Mostra o número total de lances jogados desde o início.</string>
    <string name="guide_fast_move_desc">Ajuste dinâmico da velocidade conforme a frequência dos lances ou uma penalização acumulada.</string>
    <string name="guide_fide_desc">Ritmo de torneio por etapas (por exemplo, 40 lances em 90 min + 30 min de bónus).</string>
    <string name="guide_gong_desc">Lances impostos a intervalos fixos (simultâneos ou à vez).</string>
    <string name="guide_hidden_desc">Esconde os dígitos do relógio em certos limiares para aumentar a tensão.</string>
    <string name="guide_hourglass_desc">O tempo que um jogador perde é somado ao adversário. O tempo total mantém-se constante.</string>
    <string name="guide_move_global_desc">O tempo de lance e o tempo global correm ao mesmo tempo. Ambos têm de ficar acima de zero.</string>
    <string name="guide_move_global_shared_desc">Todos os jogadores partilham uma reserva global e têm ainda um relógio de lance próprio.</string>
    <string name="guide_move_overtime_desc">Acrescenta o tempo de lance não usado a uma reserva global secundária.</string>
    <string name="guide_move_save_cap_desc">O tempo de lance não usado vai para um banco, limitado por um teto máximo.</string>
    <string name="guide_move_shared_desc">Um único relógio para todos os jogadores. Muda automaticamente às 0:00.</string>
    <string name="guide_move_standard_desc">Volta a uma duração fixa em cada lance.</string>
    <string name="guide_omni_desc">Estação profissional de 6 níveis para estruturas de jogo complexas (partidas &gt; rondas &gt; vezes &gt; fases).</string>
    <string name="guide_phases_desc">Sequência de relógios diferentes (por exemplo, preparação 5 min -&gt; partida 20 min -&gt; Sudden Death).</string>
    <string name="guide_random_desc">O tempo base e os incrementos são sorteados dentro de um intervalo definido.</string>
    <string name="guide_section_advanced">Motores avançados e experimentais</string>
    <string name="guide_section_bonus">Motores com bónus</string>
    <string name="guide_section_specialty">Motores especiais</string>
    <string name="guide_sudden_death_standard_desc">Contagem pura. O primeiro jogador a chegar a 0:00 perde ou cai.</string>

