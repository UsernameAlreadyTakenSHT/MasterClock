    <!-- Mode guide: names stay English, descriptions are translated -->
    <string name="guide_intro">Documentation exhaustive des moteurs de temps de MasterClock et de leurs sous-modes, dans l\'ordre de l\'interface.</string>
    <string name="guide_bonus_bronstein_desc">Restitue le temps passé sur le coup, sans jamais dépasser le délai réglé. Non cumulatif.</string>
    <string name="guide_bonus_fischer_desc">Ajoute un temps fixe (incrément) APRÈS chaque coup.</string>
    <string name="guide_bonus_us_delay_desc">Un délai avant décompte. La pendule attend la durée du délai avant de commencer à tourner.</string>
    <string name="guide_byoyomi_canadian_desc">Les joueurs doivent jouer un nombre déterminé de coups dans une seule période plus longue.</string>
    <string name="guide_byoyomi_japanese_desc">Après le temps principal, les joueurs disposent d\'une série de périodes courtes, remises à zéro à chaque coup.</string>
    <string name="guide_byoyomi_progressive_desc">Le nombre de coups exigés augmente à chaque période terminée.</string>
    <string name="guide_chrono_countdown_desc">Chrono maître décomptant pour toute la partie.</string>
    <string name="guide_chrono_countup_desc">Mode chronomètre mesurant le temps total écoulé.</string>
    <string name="guide_chrono_one_for_all_desc">Chrono global qui ne change pas de joueur lorsqu\'on appuie sur les boutons.</string>
    <string name="guide_counts_down_desc">Part d\'une limite et décompte jusqu\'à zéro coup restant.</string>
    <string name="guide_counts_up_desc">Affiche le nombre total de coups joués depuis le début.</string>
    <string name="guide_fast_move_desc">Ajustement dynamique de la vitesse selon la fréquence des coups ou une pénalité cumulée.</string>
    <string name="guide_fide_desc">Cadence de tournoi à plusieurs étapes (par ex. 40 coups en 90 min + 30 min de bonus).</string>
    <string name="guide_gong_desc">Coups imposés à intervalles fixes (simultanés ou à tour de rôle).</string>
    <string name="guide_hidden_desc">Masque les chiffres de la pendule à certains seuils pour faire monter la tension.</string>
    <string name="guide_hourglass_desc">Le temps perdu par un joueur est ajouté à l\'adversaire. Le temps total reste constant.</string>
    <string name="guide_move_global_desc">Le temps de coup et le temps global s\'écoulent en même temps. Les deux doivent rester au-dessus de zéro.</string>
    <string name="guide_move_global_shared_desc">Tous les joueurs partagent une réserve globale tout en ayant un chrono de coup personnel.</string>
    <string name="guide_move_overtime_desc">Ajoute le temps de coup non utilisé à une réserve globale secondaire.</string>
    <string name="guide_move_save_cap_desc">Le temps de coup non utilisé est mis en banque, dans la limite d\'un plafond.</string>
    <string name="guide_move_shared_desc">Un seul chrono pour tous les joueurs. Changement automatique à 0:00.</string>
    <string name="guide_move_standard_desc">Remise à une durée fixe à chaque coup.</string>
    <string name="guide_omni_desc">Station professionnelle à 6 niveaux pour les structures de jeu complexes (parties &gt; manches &gt; tours &gt; phases).</string>
    <string name="guide_phases_desc">Succession de chronos différents (par ex. préparation 5 min -&gt; partie 20 min -&gt; Sudden Death).</string>
    <string name="guide_random_desc">Le temps de base et les incréments sont tirés au hasard dans une plage définie.</string>
    <string name="guide_section_advanced">Moteurs avancés et expérimentaux</string>
    <string name="guide_section_bonus">Moteurs à bonus</string>
    <string name="guide_section_specialty">Moteurs spécialisés</string>
    <string name="guide_sudden_death_standard_desc">Décompte pur. Le premier joueur à atteindre 0:00 perd ou tombe.</string>

