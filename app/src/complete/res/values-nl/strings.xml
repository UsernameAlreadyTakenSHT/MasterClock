    <!-- Mode guide: names stay English, descriptions are translated -->
    <string name="guide_intro">Volledige documentatie van de tijdmodi van MasterClock en hun submodi, in de volgorde van de interface.</string>
    <string name="guide_bonus_bronstein_desc">Geeft de tijd van de zet terug, maar nooit meer dan de ingestelde vertraging. Niet cumulatief.</string>
    <string name="guide_bonus_fischer_desc">Voegt NA elke zet een vaste tijd (increment) toe.</string>
    <string name="guide_bonus_us_delay_desc">Een vertraging vóór het aftellen. De klok wacht de vertraging af voordat hij begint te lopen.</string>
    <string name="guide_byoyomi_canadian_desc">Spelers moeten een vast aantal zetten doen binnen één langere periode.</string>
    <string name="guide_byoyomi_japanese_desc">Na de hoofdtijd krijgen spelers een reeks korte periodes, die bij elke zet opnieuw beginnen.</string>
    <string name="guide_byoyomi_progressive_desc">Het aantal vereiste zetten neemt toe bij elke voltooide periode.</string>
    <string name="guide_chrono_countdown_desc">Hoofdklok die de hele partij aftelt.</string>
    <string name="guide_chrono_countup_desc">Stopwatchmodus die de totale verstreken tijd meet.</string>
    <string name="guide_chrono_one_for_all_desc">Globale klok die niet van speler wisselt wanneer op de knoppen wordt gedrukt.</string>
    <string name="guide_counts_down_desc">Begint bij een limiet en telt af tot nul resterende zetten.</string>
    <string name="guide_counts_up_desc">Toont het totale aantal zetten sinds het begin.</string>
    <string name="guide_fast_move_desc">Dynamische aanpassing van het tempo op basis van zetfrequentie of opgebouwde straf.</string>
    <string name="guide_fide_desc">Toernooitempo in meerdere fases (bijvoorbeeld 40 zetten in 90 min + 30 min bonus).</string>
    <string name="guide_gong_desc">Verplichte zetten op vaste intervallen (gelijktijdig of om beurten).</string>
    <string name="guide_hidden_desc">Verbergt de cijfers van de klok bij bepaalde drempels om de spanning op te voeren.</string>
    <string name="guide_hourglass_desc">De tijd die een speler verliest wordt bij de tegenstander opgeteld. De totale tijd blijft gelijk.</string>
    <string name="guide_move_global_desc">Zettijd en globale tijd lopen tegelijk. Beide moeten boven nul blijven.</string>
    <string name="guide_move_global_shared_desc">Alle spelers delen een globale voorraad en hebben daarnaast een eigen zetklok.</string>
    <string name="guide_move_overtime_desc">Voegt ongebruikte zettijd toe aan een tweede globale voorraad.</string>
    <string name="guide_move_save_cap_desc">Ongebruikte zettijd gaat naar een bank, met een maximum.</string>
    <string name="guide_move_shared_desc">Eén klok voor alle spelers. Wisselt automatisch bij 0:00.</string>
    <string name="guide_move_standard_desc">Gaat bij elke zet terug naar een vaste duur.</string>
    <string name="guide_omni_desc">Professionele centrale met 6 niveaus voor complexe spelstructuren (partijen &gt; rondes &gt; beurten &gt; fases).</string>
    <string name="guide_phases_desc">Opeenvolging van verschillende klokken (bijvoorbeeld voorbereiding 5 min -&gt; partij 20 min -&gt; Sudden Death).</string>
    <string name="guide_random_desc">Basistijd en incrementen worden geloot binnen een ingesteld bereik.</string>
    <string name="guide_section_advanced">Geavanceerde en experimentele modi</string>
    <string name="guide_section_bonus">Modi met bonus</string>
    <string name="guide_section_specialty">Speciale modi</string>
    <string name="guide_sudden_death_standard_desc">Puur aftellen. De eerste speler die 0:00 bereikt verliest of valt.</string>

