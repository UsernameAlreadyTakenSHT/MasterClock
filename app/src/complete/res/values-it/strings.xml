    <!-- Mode guide: names stay English, descriptions are translated -->
    <string name="guide_intro">Documentazione completa dei motori di tempo di MasterClock e delle loro sottomodalità, nell\'ordine dell\'interfaccia.</string>
    <string name="guide_bonus_bronstein_desc">Restituisce il tempo speso nella mossa, senza mai superare il ritardo impostato. Non cumulativo.</string>
    <string name="guide_bonus_fischer_desc">Aggiunge un tempo fisso (incremento) DOPO ogni mossa.</string>
    <string name="guide_bonus_us_delay_desc">Un ritardo prima del conteggio. L\'orologio attende la durata del ritardo prima di iniziare a scorrere.</string>
    <string name="guide_byoyomi_canadian_desc">I giocatori devono completare un numero preciso di mosse in un unico periodo più lungo.</string>
    <string name="guide_byoyomi_japanese_desc">Dopo il tempo principale i giocatori dispongono di una serie di periodi brevi, azzerati a ogni mossa.</string>
    <string name="guide_byoyomi_progressive_desc">Il numero di mosse richieste cresce a ogni periodo completato.</string>
    <string name="guide_chrono_countdown_desc">Orologio principale che conta alla rovescia per tutta la partita.</string>
    <string name="guide_chrono_countup_desc">Modalità cronometro che misura il tempo totale trascorso.</string>
    <string name="guide_chrono_one_for_all_desc">Orologio globale che non cambia giocatore quando si premono i pulsanti.</string>
    <string name="guide_counts_down_desc">Parte da un limite e scende fino a zero mosse rimaste.</string>
    <string name="guide_counts_up_desc">Mostra il numero totale di mosse giocate dall\'inizio.</string>
    <string name="guide_fast_move_desc">Regolazione dinamica della velocità in base alla frequenza delle mosse o a una penalità accumulata.</string>
    <string name="guide_fide_desc">Cadenza da torneo a più fasi (per esempio 40 mosse in 90 min + 30 min di bonus).</string>
    <string name="guide_gong_desc">Mosse imposte a intervalli fissi (simultanee o a turno).</string>
    <string name="guide_hidden_desc">Nasconde le cifre dell\'orologio a certe soglie per aumentare la tensione.</string>
    <string name="guide_hourglass_desc">Il tempo perso da un giocatore viene aggiunto all\'avversario. Il tempo totale resta costante.</string>
    <string name="guide_move_global_desc">Tempo per mossa e tempo globale scorrono insieme. Entrambi devono restare sopra lo zero.</string>
    <string name="guide_move_global_shared_desc">Tutti i giocatori condividono una riserva globale e hanno inoltre un timer di mossa personale.</string>
    <string name="guide_move_overtime_desc">Aggiunge il tempo di mossa non usato a una riserva globale secondaria.</string>
    <string name="guide_move_save_cap_desc">Il tempo di mossa non usato finisce in una banca, con un tetto massimo.</string>
    <string name="guide_move_shared_desc">Un solo orologio per tutti i giocatori. Cambia automaticamente a 0:00.</string>
    <string name="guide_move_standard_desc">Torna a una durata fissa a ogni mossa.</string>
    <string name="guide_omni_desc">Stazione professionale a 6 livelli per strutture di gioco complesse (partite &gt; manche &gt; turni &gt; fasi).</string>
    <string name="guide_phases_desc">Sequenza di orologi diversi (per esempio preparazione 5 min -&gt; partita 20 min -&gt; Sudden Death).</string>
    <string name="guide_random_desc">Tempo base e incrementi sono estratti a caso in un intervallo definito.</string>
    <string name="guide_section_advanced">Motori avanzati e sperimentali</string>
    <string name="guide_section_bonus">Motori con bonus</string>
    <string name="guide_section_specialty">Motori speciali</string>
    <string name="guide_sudden_death_standard_desc">Conteggio puro. Il primo giocatore che arriva a 0:00 perde o cade.</string>

