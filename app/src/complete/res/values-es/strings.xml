    <!-- Mode guide: names stay English, descriptions are translated -->
    <string name="guide_intro">Documentación exhaustiva de los motores de tiempo de MasterClock y sus submodos, siguiendo el orden de la interfaz.</string>
    <string name="guide_bonus_bronstein_desc">Devuelve el tiempo empleado en la jugada, sin superar nunca la demora configurada. No es acumulativo.</string>
    <string name="guide_bonus_fischer_desc">Añade una cantidad fija de tiempo (incremento) DESPUÉS de cada jugada.</string>
    <string name="guide_bonus_us_delay_desc">Una demora previa al descuento. El reloj espera la duración de la demora antes de empezar a correr.</string>
    <string name="guide_byoyomi_canadian_desc">Los jugadores deben completar un número concreto de jugadas dentro de un único periodo más largo.</string>
    <string name="guide_byoyomi_japanese_desc">Tras el tiempo principal, los jugadores disponen de una serie de periodos cortos, que se reinician con cada jugada.</string>
    <string name="guide_byoyomi_progressive_desc">El número de jugadas exigidas aumenta cada vez que se completa un periodo.</string>
    <string name="guide_chrono_countdown_desc">Reloj maestro que descuenta durante toda la partida.</string>
    <string name="guide_chrono_countup_desc">Modo cronómetro que mide el tiempo total transcurrido.</string>
    <string name="guide_chrono_one_for_all_desc">Reloj global que no cambia de jugador cuando se pulsan los botones.</string>
    <string name="guide_counts_down_desc">Parte de un límite y descuenta hasta cero jugadas restantes.</string>
    <string name="guide_counts_up_desc">Muestra el número total de jugadas realizadas desde el inicio.</string>
    <string name="guide_fast_move_desc">Ajuste dinámico de la velocidad según la frecuencia de jugadas o una penalización acumulada.</string>
    <string name="guide_fide_desc">Ritmo de torneo por etapas (por ejemplo, 40 jugadas en 90 min + 30 min de bonificación).</string>
    <string name="guide_gong_desc">Jugadas forzadas a intervalos fijos (simultáneas o por turnos).</string>
    <string name="guide_hidden_desc">Oculta las cifras del reloj en ciertos umbrales para aumentar la tensión.</string>
    <string name="guide_hourglass_desc">El tiempo que pierde un jugador se suma al del rival. El tiempo total se mantiene constante.</string>
    <string name="guide_move_global_desc">El tiempo de jugada y el tiempo global corren a la vez. Ambos deben mantenerse por encima de cero.</string>
    <string name="guide_move_global_shared_desc">Todos los jugadores comparten una reserva global y además tienen un reloj de jugada propio.</string>
    <string name="guide_move_overtime_desc">Añade el tiempo de jugada no utilizado a una reserva global secundaria.</string>
    <string name="guide_move_save_cap_desc">El tiempo de jugada no utilizado se guarda en un banco, con un tope máximo.</string>
    <string name="guide_move_shared_desc">Un único reloj para todos los jugadores. Cambia automáticamente a las 0:00.</string>
    <string name="guide_move_standard_desc">Vuelve a una duración fija en cada jugada.</string>
    <string name="guide_omni_desc">Estación profesional de 6 niveles para estructuras de juego complejas (partidas &gt; rondas &gt; turnos &gt; fases).</string>
    <string name="guide_phases_desc">Secuencia de relojes distintos (por ejemplo, preparación 5 min -&gt; partida 20 min -&gt; Sudden Death).</string>
    <string name="guide_random_desc">El tiempo base y los incrementos se sortean dentro de un rango definido.</string>
    <string name="guide_section_advanced">Motores avanzados y experimentales</string>
    <string name="guide_section_bonus">Motores con bonificación</string>
    <string name="guide_section_specialty">Motores especiales</string>
    <string name="guide_sudden_death_standard_desc">Descuento puro. El primer jugador que llega a 0:00 pierde o se le cae la bandera.</string>

