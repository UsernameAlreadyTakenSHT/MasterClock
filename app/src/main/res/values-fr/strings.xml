<?xml version="1.0" encoding="utf-8"?>
<!--
  MasterClock — fr

  Mode names (Fischer, Byoyomi, Sudden Death…) and chess variant names are Kotlin literals rather
  than resources, so they stay in English by construction — see the notes in values/strings.xml.

  app_name and settings_app_version are left out on purpose: they are the product name, and there is
  nothing in them to translate.

  tools:ignore="MissingTranslation" keeps the build at zero lint warnings while the file is still
  partial; it does not hide anything you need to see.
-->
