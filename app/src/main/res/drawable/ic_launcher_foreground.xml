<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <!-- Scaled to 60% around the center. The 66dp safe zone allows 73%, which is what this
         was. Nothing was being clipped, but filling that zone exactly leaves the circle touching
         the mask: 65.7dp inside the 72dp a launcher actually shows, so a round mask left 3dp of
         margin and the icon read as oversized beside every system icon. 60% puts the circle at
         54dp, the proportion its neighbours use. The nested flavor-word group scales with it. -->
    <group
        android:pivotX="12"
        android:pivotY="12"
        android:scaleX="0.60"
        android:scaleY="0.60">
        <!-- The circle -->
        <path
            android:strokeColor="#000000"
            android:strokeWidth="2"
            android:strokeLineCap="round"
            android:strokeLineJoin="round"
            android:pathData="M3,12a9,9 0 1,0 18,0a9,9 0 0,0 -18,0" />
        <!-- The clock hands -->
        <path
            android:strokeColor="#000000"
            android:strokeWidth="2"
            android:strokeLineCap="round"
            android:strokeLineJoin="round"
            android:pathData="M12,7v5l3,3" />
    </group>
</vector>
