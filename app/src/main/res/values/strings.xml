    <!--
      Counted strings are plurals, not plain strings with a %d in them: English only needs two
      forms, but French treats 0 as singular and Russian or Polish need three or four. Translators
      add or drop <item> elements to match their own language.
    -->
    <plurals name="stats_chart_moves">
        <item quantity="one">%d move</item>
        <item quantity="other">%d moves</item>
    </plurals>

    <plurals name="stats_chart_description">
        <item quantity="one">Time per move. Slowest %1$s over %2$d move.</item>
        <item quantity="other">Time per move. Slowest %1$s over %2$d moves.</item>
    </plurals>

