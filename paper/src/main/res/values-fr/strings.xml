    <string name="credits_rules_documents">Documents de règles</string>
    <string name="credits_libraries">MasterClock est construit avec ces bibliothèques open source.</string>

    <!-- Sharing -->
    <string name="share_settings">Partager les réglages</string>
    <string name="toast_backup_ok">Sauvegarde réussie !</string>
    <string name="toast_import_ok">Import réussi !</string>

    <!-- Screen-reader wording -->
    <string name="a11y_player_clock">Joueur %1$d, %2$s</string>
    <string name="a11y_player_clock_active">Joueur %1$d, %2$s, à vous de jouer</string>
    <string name="a11y_out_of_time">temps écoulé</string>
    <string name="a11y_no_time_left">plus de temps</string>
    <string name="a11y_announce_out_of_time">Le joueur %d n\'a plus de temps</string>
    <string name="a11y_announce_paused">En pause</string>
    <string name="a11y_announce_to_move">Au joueur %d de jouer</string>
    <string name="a11y_announce_byoyomi">%1$s, byoyomi</string>
    <string name="a11y_announce_byoyomi_periods">%1$s, byoyomi, %2$s</string>

    <!--
      French counts 0 as singular, so "one" covers both 0 and 1. CLDR also gives French a "many"
      category for round millions, which takes "de" ("2 000 000 de minutes"). A clock will never
      reach it, but leaving it out is a lint warning, and the form costs nothing.
    -->
    <plurals name="a11y_hours">
        <item quantity="one">%d heure</item>
        <item quantity="many">%d d\'heures</item>
        <item quantity="other">%d heures</item>
    </plurals>
    <plurals name="a11y_minutes">
        <item quantity="one">%d minute</item>
        <item quantity="many">%d de minutes</item>
        <item quantity="other">%d minutes</item>
    </plurals>
    <plurals name="a11y_seconds">
        <item quantity="one">%d seconde</item>
        <item quantity="many">%d de secondes</item>
        <item quantity="other">%d secondes</item>
    </plurals>
    <plurals name="a11y_periods_left">
        <item quantity="one">%d période restante</item>
        <item quantity="many">%d de périodes restantes</item>
        <item quantity="other">%d périodes restantes</item>
    </plurals>

    <string name="settings_version">Version %s</string>
</resources>
