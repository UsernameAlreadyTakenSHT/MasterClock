<?xml version="1.0" encoding="utf-8"?>
<!--
  MasterClock — fr

  Mode names (Timer, Fischer, Move) are Kotlin literals, not resources, so they stay in English by
  construction — see the note in values/strings.xml.

  tools:ignore="MissingTranslation" keeps the build at zero lint warnings while the file is still
  partial; it does not hide anything you need to see.
-->
<resources xmlns:tools="http://schemas.android.com/tools" tools:ignore="MissingTranslation">
    <string name="common_cancel">Annuler</string>
    <!--
      Abbreviated for paper only. This label sits on the narrow button between Reprendre and
      Réglages on the E-Ink clock, where "Réinitialiser" at 13 characters wraps to two lines and
      makes that one button taller than its neighbours. "Reprendre" at 9 is what fits. The app
      module has room and keeps the full word.
    -->
    <string name="common_reset">Réinit.</string>
    <string name="timer_reset_title">Réinitialiser la partie ?</string>
    <string name="timer_reset_message">L\'état actuel sera perdu.</string>
    <string name="common_back">Retour</string>
    <string name="common_close">Fermer</string>
    <string name="common_clear">Effacer</string>
    <string name="common_player_n">Joueur %d</string>

    <!-- Timer -->
    <string name="timer_switch_turn">Changer de tour</string>
    <string name="timer_pause">Pause</string>
    <string name="timer_resume">Reprendre</string>
    <string name="timer_settings">Réglages</string>

    <!-- Settings -->
    <string name="settings_tab_modes">Modes</string>
    <!-- Same shortening as the app module: "Comportement" wraps in the tab bar. -->
    <string name="settings_tab_behavior">Jeu</string>
    <string name="settings_tab_display">Affichage</string>
    <string name="settings_tab_audio">Audio</string>
    <string name="settings_tab_more">Plus</string>
    <string name="settings_tab_omni">Omni</string>
    <string name="settings_not_optimized">Cette page de réglages n\'est pas encore optimisée pour l\'encre électronique.</string>
    <string name="settings_initial_time">Temps initial</string>
    <string name="settings_increment">Incrément</string>
    <string name="settings_move_time">Temps par coup</string>
    <string name="settings_system_behavior">Comportement du système</string>
    <string name="settings_sound">Son</string>
    <string name="settings_haptic_feedback">Retour haptique</string>
    <string name="settings_keep_awake">Garder l\'écran allumé</string>
    <string name="settings_fullscreen">Plein écran</string>
    <string name="settings_reverse_colors">Inverser les couleurs</string>
    <string name="settings_clear_logs">Effacer l\'historique</string>
    <string name="settings_clear_logs_title">Supprimer définitivement tout l\'historique des parties ?</string>
    <string name="settings_reset_settings">Réinitialiser les réglages</string>
