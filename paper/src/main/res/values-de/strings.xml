    <string name="settings_keep_awake">Bildschirm anlassen</string>
    <string name="settings_fullscreen">Vollbild</string>
    <string name="settings_reverse_colors">Farben umkehren</string>
    <string name="settings_clear_logs">Verlauf löschen</string>
