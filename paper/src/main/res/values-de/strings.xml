<?xml version="1.0" encoding="utf-8"?>
<!--
  MasterClock — de

  Mode names (Timer, Fischer, Move) are Kotlin literals, not resources, so they stay in English by
  construction — see the note in values/strings.xml.

  German runs long, and this file is where that bites hardest: the three buttons under the E-Ink
  clock are narrow. "Zurücksetzen" and "Einstellungen" are both too wide for them and are shortened
  here; the app module has room and uses the full words.

  Translated without a native reviewer, like the Spanish.
-->
<resources xmlns:tools="http://schemas.android.com/tools" tools:ignore="MissingTranslation">
    <string name="common_cancel">Abbrechen</string>
    <!-- "Zurücksetzen" at 12 characters wraps on the narrow clock button; "Reset" is current in German UIs. -->
    <string name="common_reset">Reset</string>
    <string name="timer_reset_title">Partie zurücksetzen?</string>
    <string name="timer_reset_message">Der aktuelle Stand geht verloren.</string>
    <string name="common_back">Zurück</string>
    <string name="common_close">Schließen</string>
    <string name="common_clear">Löschen</string>
    <string name="common_player_n">Spieler %d</string>

    <!-- Timer -->
    <string name="timer_switch_turn">Zug wechseln</string>
    <string name="timer_pause">Pause</string>
    <string name="timer_resume">Weiter</string>
    <!-- "Einstellungen" at 13 characters does not fit the button beside Reset and Weiter. -->
    <string name="timer_settings">Optionen</string>

    <!-- Settings -->
    <string name="settings_tab_modes">Modi</string>
    <!-- Short like the French "Jeu" and Spanish "Juego": "Verhalten" crowds the tab row. -->
