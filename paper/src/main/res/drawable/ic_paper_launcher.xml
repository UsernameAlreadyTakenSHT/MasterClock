<?xml version="1.0" encoding="utf-8"?>
<!-- The launcher icon, drawn as Mudita draws its own for the Kompakt: Chess and Calculator, whose
     sources are public, are each one 81-unit vector named straight from the manifest: a rounded
     square in a 2.5 line against the edges, corners of about 19, and a figure in the same line some
     four tenths as wide as the square. Not an adaptive icon: that launcher adds no frame of its
     own, and the white background of one is not seen on a white screen, so the clock stood bare
     beside framed neighbours.

     The square is filled white, which theirs is not. On the Kompakt it changes nothing; on a
     launcher with a dark wallpaper, a black line with nothing behind it is not seen at all. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="81dp"
    android:height="81dp"
    android:viewportWidth="81"
    android:viewportHeight="81">
    <!-- The frame: its line's middle 1.25 in from the edge, so the line itself reaches it. -->
    <path
        android:fillColor="#FFFFFF"
        android:strokeColor="#000000"
        android:strokeWidth="2.5"
        android:pathData="M19.25,1.25H61.75A18,18 0 0 1 79.75,19.25V61.75A18,18 0 0 1 61.75,79.75H19.25A18,18 0 0 1 1.25,61.75V19.25A18,18 0 0 1 19.25,1.25Z" />
    <!-- The clock, 33 wide over all: the logo's own circle and hands, at 15.25 / 9 of their size. -->
    <path
        android:strokeColor="#000000"
        android:strokeWidth="2.5"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M25.25,40.5a15.25,15.25 0 1,0 30.5,0a15.25,15.25 0 0,0 -30.5,0" />
    <path
        android:strokeColor="#000000"
        android:strokeWidth="2.5"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M40.5,32.03V40.5L45.58,45.58" />
</vector>
