    <string name="settings_increment">Increment</string>
    <string name="settings_move_time">Tijd per zet</string>
    <string name="settings_system_behavior">Systeemgedrag</string>
    <string name="settings_sound">Geluid</string>
    <string name="settings_haptic_feedback">Haptische feedback</string>
    <string name="settings_keep_awake">Scherm aan houden</string>
    <string name="settings_fullscreen">Volledig scherm</string>
    <string name="settings_reverse_colors">Kleuren omkeren</string>
    <string name="settings_clear_logs">Geschiedenis wissen</string>
    <string name="settings_clear_logs_title">De volledige partijgeschiedenis definitief verwijderen?</string>
