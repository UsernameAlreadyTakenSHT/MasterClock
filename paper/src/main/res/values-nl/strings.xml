<?xml version="1.0" encoding="utf-8"?>
<!--
  MasterClock — nl

  Mode names (Timer, Fischer, Move) are Kotlin literals, not resources, so they stay in English by
  construction — see the note in values/strings.xml.

  The three buttons under the E-Ink clock are narrow: "Instellingen" does not fit and is "Opties"
  here, the same shortening German, Italian and Portuguese needed. The app module has room and
  keeps the full word.

  Translated without a native reviewer, like every language here except the French.
-->
<resources xmlns:tools="http://schemas.android.com/tools" tools:ignore="MissingTranslation">
    <string name="common_cancel">Annuleren</string>
    <string name="common_reset">Reset</string>
    <string name="timer_reset_title">Partij resetten?</string>
    <string name="timer_reset_message">De huidige stand gaat verloren.</string>
    <string name="common_back">Terug</string>
    <string name="common_close">Sluiten</string>
    <string name="common_clear">Wissen</string>
    <string name="common_player_n">Speler %d</string>

    <!-- Timer -->
    <string name="timer_switch_turn">Beurt wisselen</string>
    <string name="timer_pause">Pauze</string>
    <string name="timer_resume">Hervatten</string>
    <!-- "Instellingen" at 12 characters does not fit beside Reset and Hervatten. -->
    <string name="timer_settings">Opties</string>

    <!-- Settings -->
    <string name="settings_tab_modes">Modi</string>
    <!-- Short like the French "Jeu", German "Spiel", Italian "Gioco" and Portuguese "Jogo". -->
    <string name="settings_tab_behavior">Spel</string>
    <string name="settings_tab_display">Scherm</string>
    <string name="settings_tab_audio">Audio</string>
    <string name="settings_tab_more">Meer</string>
    <string name="settings_tab_omni">Omni</string>
