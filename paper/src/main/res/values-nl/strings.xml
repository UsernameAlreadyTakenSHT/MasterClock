    <string name="toast_backup_ok">Back-up gelukt!</string>
    <string name="toast_import_ok">Import gelukt!</string>

    <!-- Screen-reader wording -->
    <string name="a11y_player_clock">Speler %1$d, %2$s</string>
    <string name="a11y_player_clock_active">Speler %1$d, %2$s, jij bent aan zet</string>
    <string name="a11y_out_of_time">tijd op</string>
    <string name="a11y_no_time_left">geen tijd meer</string>
    <string name="a11y_announce_out_of_time">Speler %d heeft geen tijd meer</string>
