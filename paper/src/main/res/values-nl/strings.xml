    <string name="a11y_announce_byoyomi_periods">%1$s, byoyomi, %2$s</string>

    <!-- CLDR gives Dutch two plural categories, one and other, like German. -->
    <plurals name="a11y_hours">
        <item quantity="one">%d uur</item>
        <item quantity="other">%d uur</item>
    </plurals>
    <plurals name="a11y_minutes">
