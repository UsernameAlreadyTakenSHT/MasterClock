    <!--
      CLDR gives Spanish the same three categories as French: "one", "many" for round millions
      ("2 000 000 de minutos"), and "other". A clock will never reach "many", but lint checks the
      categories rather than the plausible range.
    -->
    <plurals name="a11y_hours">
        <item quantity="one">%d hora</item>
        <item quantity="many">%d de horas</item>
        <item quantity="other">%d horas</item>
    </plurals>
    <plurals name="a11y_minutes">
        <item quantity="one">%d minuto</item>
        <item quantity="many">%d de minutos</item>
        <item quantity="other">%d minutos</item>
    </plurals>
    <plurals name="a11y_seconds">
        <item quantity="one">%d segundo</item>
        <item quantity="many">%d de segundos</item>
        <item quantity="other">%d segundos</item>
    </plurals>
    <plurals name="a11y_periods_left">
        <item quantity="one">queda %d periodo</item>
        <item quantity="many">quedan %d de periodos</item>
        <item quantity="other">quedan %d periodos</item>
    </plurals>

    <string name="settings_version">Versión %s</string>
</resources>
