<?xml version="1.0" encoding="utf-8"?>
<!--
  MasterClock Paper — tr (Turkish)

  Mode names (Timer, Fischer, Move) are Kotlin literals, not resources, so they stay in English by
  construction — see the note in values/strings.xml.

  The three buttons under the E-Ink clock are narrow, so they take the shortest everyday words:
  "Sıfırla", "Başlat" / "Duraklat" / "Devam" and "Ayarlar". "Devam et", which the app module uses
  for Resume, is cut to "Devam" here, as German cut "Fortsetzen" to "Weiter". "Ayarlar" also has
  no letter i, which matters because the settings screen upper-cases it in Kotlin without a
  locale: a word with an i would come out with I where Turkish wants İ.

  Translated without a native reviewer, like every language here except the French.
-->
<resources xmlns:tools="http://schemas.android.com/tools" tools:ignore="MissingTranslation">
    <string name="common_cancel">İptal</string>
    <string name="common_reset">Sıfırla</string>
    <string name="timer_reset_title">Oyun sıfırlansın mı?</string>
    <string name="timer_reset_message">Mevcut durum kaybolacak.</string>
    <string name="common_back">Geri</string>

    <!-- Timer -->
    <string name="timer_switch_turn">Sırayı değiştir</string>
    <string name="timer_pause">Duraklat</string>
    <!-- One of three buttons across a Kompakt: "Devam et" is cut to "Devam". -->
    <string name="timer_resume">Devam</string>
    <string name="timer_start">Başlat</string>
    <string name="timer_settings">Ayarlar</string>
    <string name="timer_time_up">SÜRE BİTTİ</string>

    <!-- Settings -->
    <string name="settings_initial_time">Başlangıç süresi</string>
    <string name="settings_increment">Artış</string>
    <string name="settings_move_time">Hamle süresi</string>
